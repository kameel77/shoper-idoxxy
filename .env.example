# Server
PORT=3000

# Idoxxy API
IDOXXY_API_KEY=your_idoxxy_api_key
IDOXXY_CLIENT_ID=your_idoxxy_client_id
IDOXXY_CLIENT_SECRET=your_idoxxy_client_secret
IDOXXY_BASE_URL=https://api.idoxxy.com

# Shoper API
SHOPER_CLIENT_ID=your_shoper_client_id
SHOPER_CLIENT_SECRET=your_shoper_client_secret
SHOPER_BASE_URL=https://twoj-sklep.shoper.pl/webapi/rest

# Shoper webhook signature (customer.created / order.created) - REQUIRED in
# production, min. 32 characters. Without it webhooks are accepted unsigned.
SHOPER_WEBHOOK_SECRET=your-webhook-secret-min-32-characters-long

# Shoper App Store secret ("appstore_secret" from the App Store developer
# panel, generated during application registration) - REQUIRED in production.
# Verifies POST /uninstall, /billing/subscription and /billing/automatic-messages.
SHOPER_APPSTORE_SECRET=your_appstore_secret

# Session secret (change in production!)
SESSION_SECRET=your-super-secret-key-min-32-characters-long

# Operator/admin account bootstrap (see src/repositories/userRepository.ts
# bootstrapAdminAccount()). This account can read every merchant's connection
# and act on any shop via the ?shopId= operator override - treat its
# credentials like any other production secret.
# ADMIN_USERNAME is optional (defaults to "admin").
# ADMIN_PASSWORD is REQUIRED in production, min. 16 characters. Without it -
# or with an existing admin account still holding the old hardcoded default
# password - the app refuses to start in production. Outside production, a
# fixed developer-only default is used if this is left unset (never logged).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Encryption key for tenant tokens at rest (iDoxxy + Shoper OAuth tokens) -
# REQUIRED in production. Base64-encoded 32 bytes. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# GDPR data retention (see src/services/dataRetentionService.ts). Both must
# be positive integers - 0 is rejected at startup, not treated as "delete
# everything".
# Days to keep sync_logs rows (they contain merchants' customers' e-mail
# addresses - third-party personal data) before permanent deletion.
# GDPR-relevant: this is the retention window for that data.
SYNC_LOG_RETENTION_DAYS=90
# Days after a verified app uninstall before the shop's connection row,
# settings, event_mappings and sync_logs are permanently deleted (tokens are
# wiped immediately on uninstall, independently of this window).
# GDPR-relevant: bounds how long a former merchant's data is retained.
UNINSTALL_PURGE_GRACE_DAYS=30

# Email Configuration
# Options: sendgrid, smtp, console (console = just log to stdout for dev)
EMAIL_PROVIDER=console

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Email sender
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Shop Name
